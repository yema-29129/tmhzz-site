---
import BaseLayout from '../../layouts/BaseLayout.astro';
import AdSenseBlock from '../../components/AdSenseBlock.astro';
import SiteCard from '../../components/SiteCard.astro';
import ModernCalculators from '../../components/ModernCalculators.astro';
import posts from '../../data/posts.json';
import pages from '../../data/pages.json';
import apps from '../../data/apps.json';
import sites from '../../data/sites.json';
import tools from '../../data/tools.json';
import siteConfig from '../../data/site-config.json';

export function getStaticPaths() {
  const paths = [];
  const used = new Set();

  for (const page of pages) {
    if (!page.slug || used.has(page.slug) || page.id === 420) continue;
    used.add(page.slug);
    paths.push({
      params: { slug: page.slug },
      props: { kind: 'page', page, post: null },
    });
  }

  for (const post of posts) {
    if (!post.slug || used.has(post.slug)) continue;
    used.add(post.slug);
    paths.push({
      params: { slug: post.slug },
      props: { kind: 'post', post, page: null },
    });
  }

  return paths;
}

const { kind, page, post } = Astro.props;

// Prepare post navigation if kind === 'post'
const postIndex = kind === 'post' ? posts.findIndex((p) => p.id === post.id) : -1;
const prevPost = postIndex > 0 ? posts[postIndex - 1] : null;
const nextPost = postIndex >= 0 && postIndex < posts.length - 1 ? posts[postIndex + 1] : null;

// Special page detection
const isNotesPage = kind === 'page' && page.id === 376;
const isDownloadPage = kind === 'page' && page.id === 453;
const isCalcIndexPage = kind === 'page' && page.id === 174;
const isLinksPage = kind === 'page' && page.id === 9;
const isRankingsPage = kind === 'page' && page.id === 7;
const isCalculator = kind === 'page' && page.isCalculator;

const calcPages = pages.filter((p) => p.isCalculator);
const allPostCategories = Array.from(
  new Set(posts.flatMap((p) => p.categories.map((c) => c.name)))
);

const activeNav =
  kind === 'post' || isNotesPage
    ? '「天马黑珍珠」营销笔记'
    : isDownloadPage
      ? '资料下载'
      : isCalculator || isCalcIndexPage
        ? '在线工具箱'
        : '';
const seoKeywords =
  kind === 'post'
    ? [post.title, ...post.categories.map((c) => c.name), ...post.tags.map((t) => t.name), '营销笔记', '天马黑珍珠'].join(',')
    : `${page.title},天马黑珍珠,营销导航,营销工具`;

const pageJsonLd =
  kind === 'post'
    ? {
        '@context': 'https://schema.org',
        '@type': 'Article',
        headline: post.title,
        description: post.excerpt,
        datePublished: post.date,
        dateModified: post.modified || post.date,
        author: { '@type': 'Organization', name: '天马黑珍珠', url: 'https://tmhzz.com' },
        publisher: { '@type': 'Organization', name: '天马黑珍珠', url: 'https://tmhzz.com' },
        inLanguage: 'zh-CN',
      }
    : undefined;
---

<BaseLayout
  title={kind === 'post' ? post.title : page.title}
  description={kind === 'post' ? post.excerpt : `${page.title} - 天马黑珍珠营销导航与工具站`}
  keywords={seoKeywords}
  ogType={kind === 'post' ? 'article' : 'website'}
  ogImage={kind === 'post' && post.thumbnail ? post.thumbnail : undefined}
  jsonLd={pageJsonLd}
  activeNav={activeNav}
>
  <main class="container-narrow">
    <nav class="breadcrumb" aria-label="面包屑">
      <a href="/">首页</a>
      <span>/</span>
      {kind === 'post' && (
        <>
          <a href="/「天马黑珍珠」营销笔记/">营销笔记</a>
          <span>/</span>
        </>
      )}
      {isCalculator && (
        <>
          <a href="/计算器/">计算器</a>
          <span>/</span>
        </>
      )}
      <span>{kind === 'post' ? post.title : page.title}</span>
    </nav>

    {/* ===== 1. Blog Post Detail ===== */}
    {kind === 'post' && (
      <>
        <article class="panel">
          <header style="margin-bottom:20px;padding-bottom:16px;border-bottom:1px solid var(--border-color);">
            <h1 style="margin:0 0 12px;font-size:26px;line-height:1.35;">{post.title}</h1>
            <div style="display:flex;flex-wrap:wrap;gap:10px;align-items:center;font-size:13px;color:var(--text-muted);">
              <span><i class="far fa-calendar-alt" style="margin-right:4px;"></i>{post.date}</span>
              {post.categories.map((c) => (
                <span class="tag-pill">{c.name}</span>
              ))}
              {post.tags.map((t) => (
                <span class="tag-pill">#{t.name}</span>
              ))}
            </div>
          </header>

          <div class="prose" set:html={post.contentHtml} />
        </article>

        <AdSenseBlock />

        <div style="display:flex;flex-wrap:wrap;justify-content:space-between;gap:12px;margin-top:20px;">
          {prevPost ? (
            <a href={`/${prevPost.slug}/`} class="btn btn-outline">
              <i class="fas fa-arrow-left"></i>
              <span>上一篇：{prevPost.title}</span>
            </a>
          ) : <span />}
          {nextPost && (
            <a href={`/${nextPost.slug}/`} class="btn btn-outline">
              <span>下一篇：{nextPost.title}</span>
              <i class="fas fa-arrow-right"></i>
            </a>
          )}
        </div>
      </>
    )}

    {/* ===== 2. Interactive Calculator Page (Redesigned Native UI) ===== */}
    {isCalculator && (
      <>
        <div class="panel">
          <div style="display:flex;flex-wrap:wrap;justify-content:space-between;align-items:center;gap:12px;margin-bottom:18px;padding-bottom:14px;border-bottom:1px solid var(--border-color);">
            <h1 style="margin:0;font-size:23px;">{page.title}</h1>
            <div style="display:flex;flex-wrap:wrap;gap:8px;">
              {calcPages.map((cp) => (
                <a
                  href={`/${cp.slug}/`}
                  class={`btn ${cp.id === page.id ? 'btn-primary' : 'btn-outline'}`}
                  style="padding:6px 14px;font-size:13px;"
                >
                  {cp.title}
                </a>
              ))}
              <a href="/tools/" class="btn btn-outline" style="padding:6px 14px;font-size:13px;">全部 12 款工具</a>
            </div>
          </div>
          <ModernCalculators pageId={page.id} />
        </div>
        <AdSenseBlock />
      </>
    )}

    {/* ===== 3. Calculator / Toolbox Index Page ===== */}
    {isCalcIndexPage && (
      <div class="panel">
        <div style="display:flex;flex-wrap:wrap;justify-content:space-between;align-items:center;gap:10px;margin-bottom:16px;">
          <div>
            <h1 style="margin:0 0 6px;font-size:24px;">实用计算器与在线工具箱</h1>
            <p style="margin:0;color:var(--text-secondary);">共 {tools.length} 款免费纯前端工具，打开即用、实时出结果：</p>
          </div>
          <a href="/tools/" class="btn btn-primary" style="padding:7px 16px;font-size:13px;">进入完整工具箱</a>
        </div>
        <div class="article-grid">
          {tools.map((t) => (
            <a href={t.path} class="article-card" style="padding:20px;">
              <div style="display:flex;align-items:center;gap:10px;margin-bottom:10px;">
                <span style="width:36px;height:36px;border-radius:10px;background:var(--brand-soft);color:var(--brand);display:inline-flex;align-items:center;justify-content:center;font-size:16px;">
                  <i class={t.icon}></i>
                </span>
                <h2 class="article-title" style="margin:0;">{t.shortTitle}</h2>
              </div>
              <p class="article-excerpt">{t.desc}</p>
              <div class="article-meta">
                <span>{t.category}</span>
                <span style="color:var(--brand);font-weight:600;">立即使用 →</span>
              </div>
            </a>
          ))}
        </div>
      </div>
    )}

    {/* ===== 4. Marketing Notes Index Page (18 posts + category filter) ===== */}
    {isNotesPage && (
      <>
        <div class="panel">
          <h1 style="margin:0 0 10px;font-size:24px;">{page.title}</h1>
          <p style="margin:0 0 18px;color:var(--text-secondary);">
            共收录 {posts.length} 篇营销笔记与实战思考，支持按分类快速筛选。
          </p>

          <div style="display:flex;flex-wrap:wrap;gap:8px;margin-bottom:22px;" id="post-cat-filters">
            <button type="button" class="btn btn-primary" data-cat="ALL" style="padding:6px 14px;font-size:13px;">全部 ({posts.length})</button>
            {allPostCategories.map((cat) => (
              <button type="button" class="btn btn-outline" data-cat={cat} style="padding:6px 14px;font-size:13px;">{cat}</button>
            ))}
          </div>

          <div class="article-grid" id="posts-grid">
            {posts.map((p) => (
              <a
                href={`/${p.slug}/`}
                class="article-card"
                data-cats={p.categories.map((c) => c.name).join(',')}
              >
                {p.thumbnail && (
                  <div class="article-cover">
                    <img src={p.thumbnail} alt={p.title} loading="lazy" />
                  </div>
                )}
                <div class="article-body">
                  <h2 class="article-title">{p.title}</h2>
                  <p class="article-excerpt">{p.excerpt}</p>
                  <div class="article-meta">
                    <span>{p.date}</span>
                    <span>{p.categories[0]?.name || '营销笔记'}</span>
                  </div>
                </div>
              </a>
            ))}
          </div>
        </div>

        {page.contentHtml && (
          <div class="panel prose" set:html={page.contentHtml} />
        )}

        <script is:inline>
          (function () {
            var btns = document.querySelectorAll('#post-cat-filters button');
            var cards = document.querySelectorAll('#posts-grid .article-card');
            btns.forEach(function (btn) {
              btn.addEventListener('click', function () {
                btns.forEach(function (b) {
                  b.classList.remove('btn-primary');
                  b.classList.add('btn-outline');
                });
                btn.classList.remove('btn-outline');
                btn.classList.add('btn-primary');
                var cat = btn.getAttribute('data-cat');
                cards.forEach(function (card) {
                  var cats = (card.getAttribute('data-cats') || '').split(',');
                  card.style.display = (cat === 'ALL' || cats.indexOf(cat) !== -1) ? '' : 'none';
                });
              });
            });
          })();
        </script>
      </>
    )}

    {/* ===== 5. Resource Downloads Page (6 industry reports) ===== */}
    {isDownloadPage && (
      <div class="panel">
        <h1 style="margin:0 0 10px;font-size:24px;">{page.title}</h1>
        <p style="margin:0 0 22px;color:var(--text-secondary);">
          精选行业研究报告与营销资料，共 {apps.length} 份，支持百度网盘、夸克网盘、迅雷网盘直接下载。
        </p>
        <div class="article-grid">
          {apps.map((app) => (
            <a href={`/app/${app.slug}.html`} class="article-card">
              <div class="article-cover">
                {app.cover ? (
                  <img src={app.cover} alt={app.title} loading="lazy" />
                ) : (
                  <i class="fas fa-file-pdf" style="font-size:42px;color:var(--brand);"></i>
                )}
              </div>
              <div class="article-body">
                <h2 class="article-title">{app.title}</h2>
                <p class="article-excerpt">{app.summary}</p>
                <div class="article-meta">
                  <span>{app.updated || app.date}</span>
                  <span style="color:var(--brand);font-weight:600;">查看下载 →</span>
                </div>
              </div>
            </a>
          ))}
        </div>
      </div>
    )}

    {/* ===== 6. Friend Links Page ===== */}
    {isLinksPage && (
      <div class="panel">
        <h1 style="margin:0 0 14px;font-size:24px;">{page.title}</h1>
        <div class="site-grid" style="grid-template-columns:repeat(auto-fill,minmax(220px,1fr));margin-bottom:22px;">
          {siteConfig.friendLinks.map((fl) => (
            <a href={fl.url} target="_blank" rel="noopener noreferrer" class="site-card">
              <div class="site-icon-box"><i class="fas fa-link"></i></div>
              <div class="site-card-info">
                <div class="site-card-title">{fl.label}</div>
                <div class="site-card-desc">{fl.url}</div>
              </div>
            </a>
          ))}
        </div>
        {page.contentHtml && <div class="prose" set:html={page.contentHtml} />}
      </div>
    )}

    {/* ===== 7. Rankings / Featured Page ===== */}
    {isRankingsPage && (
      <div class="panel">
        <h1 style="margin:0 0 10px;font-size:24px;">精选推荐榜</h1>
        <p style="margin:0 0 20px;color:var(--text-secondary);">精选常用营销导航与最新营销笔记汇总。</p>
        <h2 style="font-size:17px;margin:0 0 14px;">精选网址（最新收录）</h2>
        <div class="site-grid" style="grid-template-columns:repeat(auto-fill,minmax(220px,1fr));margin-bottom:28px;">
          {sites.slice(0, 18).map((s) => <SiteCard site={s} />)}
        </div>
        <h2 style="font-size:17px;margin:0 0 14px;">精选营销笔记</h2>
        <div class="article-grid">
          {posts.slice(0, 6).map((p) => (
            <a href={`/${p.slug}/`} class="article-card">
              <div class="article-body">
                <h3 class="article-title">{p.title}</h3>
                <p class="article-excerpt">{p.excerpt}</p>
                <div class="article-meta"><span>{p.date}</span></div>
              </div>
            </a>
          ))}
        </div>
      </div>
    )}

    {/* ===== 8. Standard Standalone Pages ===== */}
    {kind === 'page' && !isCalculator && !isCalcIndexPage && !isNotesPage && !isDownloadPage && !isLinksPage && !isRankingsPage && (
      <article class="panel">
        <h1 style="margin:0 0 18px;font-size:24px;">{page.title}</h1>
        <div class="prose" set:html={page.contentHtml || '<p>内容持续更新中。</p>'} />
      </article>
    )}
  </main>
</BaseLayout>
