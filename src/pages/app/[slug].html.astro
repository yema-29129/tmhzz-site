---
import BaseLayout from '../../layouts/BaseLayout.astro';
import AdSenseBlock from '../../components/AdSenseBlock.astro';
import apps from '../../data/apps.json';

export function getStaticPaths() {
  return apps.map((app) => ({
    params: { slug: app.slug },
    props: { app },
  }));
}

const { app } = Astro.props;
---

<BaseLayout title={app.title} description={app.summary} activeNav="资料下载">
  <main class="container-narrow">
    <nav class="breadcrumb" aria-label="面包屑">
      <a href="/">首页</a>
      <span>/</span>
      <a href="/资料下载/">资料下载</a>
      <span>/</span>
      <span>{app.title}</span>
    </nav>

    <div class="panel">
      <div style="display:flex;flex-wrap:wrap;gap:24px;align-items:flex-start;">
        {app.cover && (
          <img
            src={app.cover}
            alt={app.title}
            style="width:160px;height:auto;border-radius:12px;border:1px solid var(--border-color);object-fit:cover;"
          />
        )}
        <div style="flex:1;min-width:240px;">
          <h1 style="margin:0 0 10px;font-size:24px;line-height:1.35;">{app.title}</h1>
          <p style="margin:0 0 14px;color:var(--text-secondary);">{app.summary}</p>
          <div style="display:flex;flex-wrap:wrap;gap:8px;margin-bottom:18px;">
            <span class="tag-pill"><i class="far fa-clock" style="margin-right:5px;"></i>更新：{app.updated || app.date}</span>
            {app.categories.map((c) => (
              <span class="tag-pill">{c.name}</span>
            ))}
          </div>

          {app.downloads.length > 0 && (
            <div style="margin-top:14px;">
              <div style="font-size:13px;font-weight:600;margin-bottom:10px;color:var(--text-primary);">
                <i class="fas fa-cloud-download-alt" style="color:var(--brand);margin-right:6px;"></i>网盘下载地址：
              </div>
              <div style="display:flex;flex-wrap:wrap;gap:10px;">
                {app.downloads.map((d) => (
                  <a href={d.url} target="_blank" rel="noopener noreferrer nofollow" class="btn btn-primary">
                    <i class="fas fa-download"></i>
                    <span>{d.label}</span>
                  </a>
                ))}
              </div>
              {app.passwords && app.passwords.length > 0 && (
                <p style="margin:10px 0 0;font-size:13px;color:var(--text-secondary);">
                  提取码：<strong>{app.passwords.join(' / ')}</strong>
                </p>
              )}
              {app.downloadNote && (
                <p style="margin:8px 0 0;font-size:12.5px;color:var(--text-muted);">{app.downloadNote}</p>
              )}
            </div>
          )}
        </div>
      </div>
    </div>

    {app.contentHtml && (
      <article class="panel prose" set:html={app.contentHtml} />
    )}

    <AdSenseBlock />
  </main>
</BaseLayout>
