  { m: 7, d: '07-07', name: '小暑 / 三伏天养生季', type: '节气热点', level: 'A', tags: '养生/茶饮/冰品/家电', idea: '借势“三伏天祛湿、晒背、冬病夏治”健康热潮，带火养生茶饮、艾灸与清凉好物。' },
  { m: 7, d: '07-23', name: '大暑 / 高温避暑经济', type: '节气热点', level: 'B', tags: '家电/饮品/夜经济/户外', idea: '聚焦避暑纳凉、夜宵经济、车载降温神器与夏日续命冷饮 DIY。' },

  // 8月
  { m: 8, d: '08-07', name: '立秋', type: '节气热点', level: 'S', tags: '奶茶/餐饮/服饰/美妆', idea: '自带热搜体质的“秋天的第一杯奶茶”！餐饮借势团购，服饰美妆启动早秋上新与保湿修护。' },
  { m: 8, d: '08-08', name: '全民健身日 / 88会员节', type: '电商大促', level: 'A', tags: '运动/健身/健康/电商', idea: '居家健身打卡、运动装备测评、配合淘宝 88VIP 与平台会员日拉升复购。' },
  { m: 8, d: '08-19', name: '七夕节（农历七月初七）', type: '传统节日', level: 'S', tags: '美妆/珠宝/奢侈品/鲜花/酒店', idea: '中国传统情人节！主打中式浪漫美学、七夕限定礼盒与“不敷衍的高级感送礼指南”。' },
  { m: 8, d: '08-25', name: '开学季大促 / 军训季', type: '电商大促', level: 'S', tags: '数码/文具/箱包/防晒/宿舍好物', idea: '大一新生必备清单、宿舍改造神器、军训防晒与学习平板/笔记本电脑横评。' },

  // 9月
  { m: 9, d: '09-01', name: '开学日 / 99划算节预热', type: '电商大促', level: 'A', tags: '教育/母婴/文具/全品类', idea: '“神兽归笼”家长共鸣话题 + 99 划算节换季囤货种草。' },
  { m: 9, d: '09-10', name: '教师节', type: '潮流营销', level: 'A', tags: '鲜花/茶饮/护嗓/文创/知识', idea: '感念师恩轻礼赠、护嗓润喉/肩颈舒缓实用好物、行业导师致敬海报。' },
  { m: 9, d: '09-25', name: '中秋节（农历八月十五）', type: '传统节日', level: 'S', tags: '月饼/酒茶/大闸蟹/企业采购/文旅', idea: '提前 1 个月启动 B 端企业定制礼盒 + C 端送长辈体面礼，主打团圆赏月与国风设计。' },

  // 10月
  { m: 10, d: '10-01', name: '国庆节 / 十一黄金周', type: '传统节日', level: 'S', tags: '文旅/酒店/汽车/婚礼/餐饮', idea: '长途旅游、婚礼旺季（伴手礼/新婚家电）与高速/景区实用攻略内容井喷。' },
  { m: 10, d: '10-18', name: '重阳节（农历九月初九）', type: '传统节日', level: 'B', tags: '银发经济/健康/体检/旅游', idea: '关注中老年健康关怀、适老化家居好物与秋日登高赏秋攻略。' },
  { m: 10, d: '10-20', name: '双 11 狂欢节抢先购 / 预售开启', type: '电商大促', level: 'S', tags: '全品类/电商/投流/达人种草', idea: '全年最重磅战役！提前 15 天占领“双11必买清单、满减攻略、同款平替横评”核心词。' },
