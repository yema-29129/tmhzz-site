  { m: 4, d: '04-05', name: '清明节 / 春日踏青小长假', type: '传统节日', level: 'A', tags: '文旅/户外/防晒/食品/汽车', idea: '切入短途自驾、露营装备清单、青团时令美食与春日防晒穿搭种草。' },
  { m: 4, d: '04-20', name: '谷雨', type: '节气热点', level: 'B', tags: '茶饮/护肤/养生/文旅', idea: '谷雨新茶上新、春夏交替敏感肌修护、梅雨季除湿防潮好物推荐。' },
  { m: 4, d: '04-22', name: '世界地球日', type: '节气热点', level: 'A', tags: '环保/服饰/咖啡/新能源', idea: '自带杯立减、旧物回收换购、品牌环保理念海报，提升年轻群体品牌好感度。' },
