  { m: 2, d: '02-04', name: '立春', type: '节气热点', level: 'A', tags: '美妆/服饰/茶饮/文旅', idea: '主打“春日上新、换季焕新、春天第一杯/第一套穿搭”，视觉全面切换清新明快色调。' },
