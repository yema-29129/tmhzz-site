  { m: 6, d: '06-18', name: '618 年中大促狂欢日', type: '电商大促', level: 'S', tags: '全品类/直播电商/货架电商', idea: '全渠道冲刺收割！直播间发放限时大额券、抄作业必买清单与最后 4 小时倒计时提醒。' },
  { m: 6, d: '06-19', name: '端午节（农历五月初五）', type: '传统节日', level: 'A', tags: '食品/礼盒/文旅/国潮', idea: '新奇口味粽子测评、龙舟/艾草文创周边、端午小长假周边游攻略。' },
  { m: 6, d: '06-21', name: '父亲节（6月第三个周日） / 夏至', type: '潮流营销', level: 'A', tags: '酒茶/数码/剃须刀/汽车/保健', idea: '“沉默的父爱”反差感文案，主打实用型礼物清单，避开泛泛煽情更易转化。' },

