  { m: 5, d: '05-20', name: '520 网络情人节', type: '电商大促', level: 'S', tags: '美妆/奢侈品/数码/餐饮/礼盒', idea: '礼赠高峰！推出限定告白礼盒、定制刻字服务与 520 顺丰次日达急单兜底攻略。' },
  { m: 5, d: '05-25', name: '618 年中大促预售启动', type: '电商大促', level: 'S', tags: '全品类/电商/投流/直播', idea: '全年第二大电商战役！提前做好小红书/知乎横评种草、保本 ROI 测算与大促机制图。' },

  // 6月
  { m: 6, d: '06-01', name: '六一儿童节 / 大小孩节', type: '潮流营销', level: 'S', tags: '母婴/零食/潮玩/餐饮/游戏', idea: '既打亲子送礼，更打“成年人的童心未泯”怀旧营销，联名经典动漫 IP 极易出圈。' },
