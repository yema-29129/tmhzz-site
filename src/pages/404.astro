---
import BaseLayout from '../layouts/BaseLayout.astro';
---

<BaseLayout title="页面未找到 (404)">
  <main class="container-narrow" style="text-align:center;padding:60px 20px;">
    <div class="panel" style="max-width:540px;margin:0 auto;padding:42px 24px;">
      <div style="font-size:56px;font-weight:800;color:var(--brand);line-height:1;margin-bottom:14px;">404</div>
      <h1 style="margin:0 0 10px;font-size:20px;">抱歉，您访问的页面不存在</h1>
      <p style="margin:0 0 24px;color:var(--text-secondary);font-size:14px;">
        页面可能已移动或删除，您可以返回首页或使用顶部搜索框查找所需内容。
      </p>
      <a href="/" class="btn btn-primary">
        <i class="fas fa-home"></i>
        <span>返回首页</span>
      </a>
    </div>
  </main>
</BaseLayout>
