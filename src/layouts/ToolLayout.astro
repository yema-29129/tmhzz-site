---
import BaseLayout from '../layouts/BaseLayout.astro';
import AdSenseBlock from '../components/AdSenseBlock.astro';
import tools from '../data/tools.json';

export interface Props {
  title: string;
  description: string;
  keywords: string;
  currentPath: string;
}

const { title, description, keywords, currentPath } = Astro.props;
const others = tools.filter((t) => t.path !== currentPath).slice(0, 6);

const toolSchema = {
  '@context': 'https://schema.org',
  '@type': 'SoftwareApplication',
  name: title,
  description,
  applicationCategory: 'BusinessApplication',
  operatingSystem: 'Web',
  url: `https://tmhzz.com${currentPath}`,
  offers: { '@type': 'Offer', price: '0', priceCurrency: 'CNY' },
};
---

<BaseLayout title={title} description={description} keywords={keywords} jsonLd={toolSchema} activeNav="在线工具箱">
  <main class="container-narrow">
    <nav class="breadcrumb" aria-label="面包屑">
      <a href="/">首页</a>
      <span>/</span>
      <a href="/tools/">在线工具箱</a>
      <span>/</span>
      <span>{title}</span>
    </nav>

    <div class="panel">
      <div style="display:flex;flex-wrap:wrap;justify-content:space-between;align-items:center;gap:12px;margin-bottom:18px;padding-bottom:14px;border-bottom:1px solid var(--border-color);">
        <div>
          <h1 style="margin:0 0 6px;font-size:23px;line-height:1.3;">{title}</h1>
          <p style="margin:0;color:var(--text-secondary);font-size:13.5px;">{description}</p>
        </div>
        <a href="/tools/" class="btn btn-outline" style="padding:6px 14px;font-size:13px;">全部 12 个工具</a>
      </div>

      <slot />
    </div>

    <AdSenseBlock />

    <section style="margin-top:26px;">
      <div class="section-header">
        <h2 class="section-title"><i class="fas fa-tools"></i>更多免费在线工具</h2>
        <a href="/tools/" class="section-more">查看全部</a>
      </div>
      <div class="article-grid">
        {others.map((t) => (
          <a href={t.path} class="article-card" style="padding:18px;">
            <div style="display:flex;align-items:center;gap:10px;margin-bottom:8px;">
              <i class={t.icon} style="color:var(--brand);font-size:18px;"></i>
              <h3 class="article-title" style="margin:0;">{t.shortTitle}</h3>
            </div>
            <p class="article-excerpt" style="margin:0;">{t.desc}</p>
          </a>
        ))}
      </div>
    </section>
  </main>

  <style is:global>
    .tool-grid { display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); gap: 16px; }
    @media (max-width: 760px) { .tool-grid { grid-template-columns: 1fr; } }
    .tool-field label { display: block; font-size: 13px; font-weight: 600; color: var(--text-secondary); margin-bottom: 6px; }
    .tool-input, .tool-select, .tool-textarea {
      width: 100%; padding: 10px 12px; border-radius: 8px;
      border: 1px solid rgba(128,128,128,0.25); background: var(--bg-body);
      color: var(--text-primary); font-size: 14px; font-family: inherit;
    }
    .tool-input:focus, .tool-select:focus, .tool-textarea:focus { outline: none; border-color: var(--brand); }
    .tool-textarea { min-height: 180px; line-height: 1.7; resize: vertical; }
    .kpi-grid { display: grid; grid-template-columns: repeat(auto-fit, minmax(170px, 1fr)); gap: 12px; margin-top: 20px; }
    .kpi-box {
      background: var(--bg-subtle); border: 1px solid var(--border-color);
      border-radius: 10px; padding: 14px 16px;
    }
    .kpi-label { font-size: 12px; color: var(--text-muted); margin-bottom: 4px; }
    .kpi-val { font-size: 22px; font-weight: 800; color: var(--text-primary); }
    .kpi-val.brand { color: var(--brand); }
    .kpi-sub { font-size: 12px; color: var(--text-secondary); margin-top: 3px; }
    .tool-table { width: 100%; border-collapse: collapse; margin-top: 16px; font-size: 13.5px; }
    .tool-table th, .tool-table td { padding: 9px 10px; border-bottom: 1px solid var(--border-color); text-align: left; }
    .tool-table th { color: var(--text-muted); font-weight: 600; background: var(--bg-subtle); }
    .hl-bad { background: rgba(241, 64, 75, 0.2); color: #d9323d; font-weight: 700; padding: 1px 4px; border-radius: 4px; }
  </style>
</BaseLayout>
