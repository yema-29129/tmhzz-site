    "isCalculator": true,
    "calculatorHtml": "\n                                <p class=\"p1\">    <div class=\"rc_container\">\n        <form method=\"post\" class=\"rc_form\">\n            <div class=\"rc_form_inner\">\n                <div class=\"rc_form_group\">\n                    <label class=\"rc_label\">性别 （请选择性别）</label>\n                    <div class=\"rc_gender_wrapper\">\n                        <label class=\"rc_gender_btn \">\n                            <input type=\"radio\" name=\"rc_gender\" value=\"male\"  onchange=\"rcToggleFemaleOption()\" required> 男性\n                        </label>\n                        <label class=\"rc_gender_btn \">\n                            <input type=\"radio\" name=\"rc_gender\" value=\"female\"  onchange=\"rcToggleFemaleOption()\" required> 女性\n                        </label>\n                    </div>\n                </div>\n\n                <div class=\"rc_form_group\" id=\"rc_female_option\" style=\"display:none;\">\n                    <label class=\"rc_label\">女性原法定退休年龄：</label>\n                    <select name=\"rc_female_category\" class=\"rc_select\">\n                        <option value=\"55\"  selected='selected'>原55岁退休</option>\n                        <option value=\"50\" >原50岁退休</option>\n                    </select>\n                </div>\n\n                <div class=\"rc_form_group\">\n                    <label class=\"rc_label\">出生日期</label>\n                    <div class=\"rc_input_wrapper\">\n                        <input type=\"date\" name=\"rc_birthdate\" value=\"\" class=\"rc_input\" required />\n                    </div>\n                </div>\n\n                <div class=\"rc_button_group\">\n                    <input type=\"submit\" name=\"rc_submit\" value=\"= 计算\" class=\"rc_calc_btn\" />\n                    <input type=\"button\" value=\"✕ 重置\" class=\"rc_reset_btn\" onclick=\"rcResetForm()\" />\n                </div>\n            </div>\n        </form>\n            </div>\n\n    <script>\n        function rcToggleFemaleOption(){\n            var gender_male = document.querySelector('input[name=\"rc_gender\"][value=\"male\"]');\n            var fopt = document.getElementById('rc_female_option');\n            if(gender_male && !gender_male.checked){\n                fopt.style.display = 'block';\n            } else {\n                fopt.style.display = 'none';\n            }\n        }\n        rcToggleFemaleOption();\n\n        function rcResetForm(){\n            document.querySelector('.rc_form').reset();\n            rcToggleFemaleOption();\n        }\n    </script>\n    <style>\n        .rc_container {\n            border: none;\n            padding: 10px;\n            font-family: \"Microsoft Yahei\", Arial, sans-serif;\n        }\n        .rc_form_inner {\n            background: #f2edd9;\n            padding: 20px;\n            border-radius: 5px;\n        }\n        .rc_form_group {\n            margin-bottom: 20px;\n        }\n        .rc_label {\n            display: inline-block;\n            margin-bottom: 5px;\n            font-weight: bold;\n            color: #333;\n        }\n        .rc_gender_wrapper {\n            display: flex;\n            gap: 10px;\n        }\n        .rc_gender_btn {\n            background: #fff;\n            border: 2px solid #008000;\n            border-radius: 5px;\n            padding: 5px 10px;\n            cursor: pointer;\n            color: #008000;\n            font-weight: bold;\n            display: inline-block;\n            line-height: 1.5;\n        }\n        .rc_gender_btn.active {\n            background: #008000;\n            color: #fff;\n        }\n        .rc_gender_btn input {\n            display: none;\n        }\n        .rc_select {\n            width: 100%;\n            padding: 5px;\n            border: 1px solid #ddd;\n            border-radius: 3px;\n        }\n        .rc_input_wrapper {\n            position: relative;\n        }\n        .rc_input {\n            width: 100%;\n            padding: 5px;\n            border: 1px solid #ddd;\n            border-radius: 3px;\n        }\n        .rc_button_group {\n            display: flex;\n            gap: 10px;\n        }\n        .rc_calc_btn {\n            background: #008000;\n            color: #fff;\n            border: none;\n            padding: 8px 15px;\n            font-size: 14px;\n            border-radius: 3px;\n            cursor: pointer;\n            font-weight: bold;\n        }\n        .rc_reset_btn {\n            background: #888;\n            color: #fff;\n            border: none;\n            padding: 8px 15px;\n            font-size: 14px;\n            border-radius: 3px;\n            cursor: pointer;\n            font-weight: bold;\n        }\n        .rc_result_wrapper {\n            margin-top: 20px;\n            background: #f7f7f7;\n            border-radius: 5px;\n            padding: 20px;\n        }\n        .rc_result_title {\n            font-weight: bold;\n            margin-bottom: 10px;\n            font-size: 16px;\n        }\n        .rc_result_content p {\n            margin: 0 0 10px 0;\n            font-size: 14px;\n        }\n        .rc_error {\n            color: red;\n            margin-top: 20px;\n        }\n    </style>\n    </p>\n                            </div>\n        </div>\n        </div>\n                </div>\n    </div>\n    <div class=\"sidebar sidebar-tools d-none d-lg-block\">\n\t\t\n\t\t\t\t\t<div id=\"custom_html-10\" class=\"widget_text card io-sidebar-widget widget_custom_html\"><div class=\"textwidget custom-html-widget\"><a href=\"https://dt.bd.cn/#/pages/login/register?invite_code=2549125\" target=\"_blank\"><img src=\"https://tmhzz.com/wp-content/themes/onenav/assets/images/ad.jpg\" alt=\"网盘推广，别人转存就有钱\" /></a></div></div><div id=\"custom_html-18\" class=\"widget_text card io-sidebar-widget widget_custom_html\"><div class=\"textwidget custom-html-widget\"><script async src=\"https://pagead2.googlesyndication.com/pa