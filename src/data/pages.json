    "id": 182,
    "slug": "复利计算器",
    "title": "复利计算器",
    "date": "2024-12-29",
    "isCalculator": true,
    "calculatorHtml": "<!DOCTYPE html>\n<html lang=\"zh-CN\">\n<head>\n<meta charset=\"UTF-8\">\n<meta name=\"viewport\" content=\"width=device-width, initial-scale=1.0\">\n<title>定投复利计算器</title>\n<style>\n  body {\n    font-family: Arial, sans-serif;\n    margin: 0;\n    /* 移除原本的flex布局和height:100vh以避免页面内容变多后跳动 */\n  }\n  h1 {\n    font-size: 28px;\n    margin-bottom: 20px;\n    text-align: center;\n  }\n  .calculator {\n    max-width: 600px;\n    padding: 20px;\n    border: 1px solid #ccc;\n    border-radius: 8px;\n    background-color: #f9f9f9;\n    text-align: left;\n    margin: 50px auto; /* 保持水平居中，并增加顶部空间让页面更美观 */\n  }\n  .input-group {\n    margin-bottom: 10px;\n    display: flex;\n    align-items: center;\n    justify-content: space-between;\n  }\n  .input-group label {\n    font-size: 16px;\n    width: 150px;\n  }\n  .input-group input, .input-group select {\n    width: calc(100% - 160px);\n    padding: 5px;\n    font-size: 16px;\n  }\n  .button-group {\n    display: flex;\n    justify-content: center;\n    gap: 20px; /* 按钮间距 */\n    margin-top: 20px;\n  }\n  button {\n    padding: 10px 20px;\n    font-size: 16px;\n    cursor: pointer;\n    background-color: #007BFF;\n    color: white;\n    border: none;\n    border-radius: 5px;\n  }\n  button:hover {\n    background-color: #0056b3;\n  }\n  #result {\n    margin-top: 20px;\n    text-align: center;\n  }\n  canvas {\n    margin-top: 20px;\n    max-width: 1100px;\n    width: 100%;\n    height: 300px;\n  }\n</style>\n</head>\n<body>\n  <h1>定投复利计算器</h1>\n  <div class=\"calculator\">\n    <div class=\"input-group\">\n      <label for=\"initialInvestment\">初始投资：</label>\n      <input type=\"number\" id=\"initialInvestment\" min=\"0\" value=\"0\" required>\n    </div>\n    <div class=\"input-group\">\n      <label for=\"monthlyIncrease\">每次定投金额：</label>\n      <input type=\"number\" id=\"monthlyIncrease\" min=\"0\" value=\"5\" required>\n    </div>\n    <div class=\"input-group\">\n      <label for=\"years\">投资年数：</label>\n      <input type=\"number\" id=\"years\" min=\"1\" value=\"1\" required>\n    </div>\n    <div class=\"input-group\">\n      <label for=\"returnRate\">年化回报率 (%)：</label>\n      <input type=\"number\" id=\"returnRate\" min=\"0\" step=\"0.1\" value=\"1\" required>\n    </div>\n    <div class=\"input-group\">\n      <label for=\"frequency\">投资频率：</label>\n      <select id=\"frequency\">\n        <option value=\"daily\" selected>每日（剔除周末）</option>\n        <option value=\"weekly\">每周</option>\n        <option value=\"biweekly\">每两周</option>\n        <option value=\"monthly\">每月</option>\n        <option value=\"quarterly\">每季度</option>\n        <option value=\"annually\">每年</option>\n      </select>\n    </div>\n    <div class=\"button-group\">\n      <button onclick=\"calculate()\">计算</button>\n      <button onclick=\"resetCalculator()\">重置</button>\n    </div>\n    <div id=\"result\"></div>\n  </div>\n\n  <canvas id=\"compoundChart\"></canvas>\n\n  <script src=\"https://cdn.jsdelivr.net/npm/chart.js\"></script>\n  <script>\n    let compoundChart;\n\n    function calculate() {\n      const initialInvestment = parseFloat(document.getElementById('initialInvestment').value);\n      const investmentAmount = parseFloat(document.getElementById('monthlyIncrease').value); \n      const years = parseFloat(document.getElementById('years').value);\n      const returnRate = parseFloat(document.getElementById('returnRate').value) / 100;\n      const frequency = document.getElementById('frequency').value;\n\n      let frequencyFactor;\n      let labelUnit;\n      switch (frequency) {\n        case 'daily':\n          frequencyFactor = 365;\n          labelUnit = '日';\n          break;\n        case 'weekly':\n          frequencyFactor = 52;\n          labelUnit = '周';\n          break;\n        case 'biweekly':\n          frequencyFactor = 26;\n          labelUnit = '两周';\n          break;\n        case 'monthly':\n          frequencyFactor = 12;\n          labelUnit = '月';\n          break;\n        case 'quarterly':\n          frequencyFactor = 4;\n          labelUnit = '季度';\n          break;\n        case 'annually':\n          frequencyFactor = 1;\n          labelUnit = '年';\n          break;\n        default:\n          frequencyFactor = 12;\n          labelUnit = '月';\n      }\n\n      const totalPeriods = years * frequencyFactor;\n      const ratePerPeriod = returnRate / frequencyFactor;\n      let totalInvestment = initialInvestment;\n      let totalAmount = initialInvestment;\n\n      const dataPoints = [];\n      const labels = [];\n      const principalData = [];\n      const compoundData = [];\n\n      for (let i = 0; i <= totalPeriods; i++) {\n        let isWeekend = false;\n        if (frequency === 'daily') {\n          const dayOfWeek = i % 7; \n          if (dayOfWeek === 5 || dayOfWeek === 6) {\n            isWeekend = true;\n          }\n        }\n\n        if (i > 0) {\n          if (frequency === 'daily') {\n            if (!isWeekend) {\n              totalAmount = (totalAmount + investmentAmount) * (1 + ratePerPeriod);\n              totalInvestment += investmentAmount;\n            } else {\n              totalAmount = totalAmount * (1 + ratePerPeriod);\n            }\n          } else {\n            totalAmount = (totalAmount + investmentAmount) * (1 + ratePerPeriod);\n            totalInvestment += investmentAmount;\n          }\n        }\n\n        labels.push(`${i} ${labelUnit}`);\n        dataPoints.push(totalAmount);\n        principalData.push(totalInvestment);\n        compoundData.push(totalAmount - totalInvestment); \n      }\n\n      const resultElement = document.getElementById('result');\n      resultElement.innerHTML = `\n        <p>总投资金额：${totalInvestment.toFixed(2)} 元</p>\n        <p>最终复利金额：${totalAmount.toFixed(2)} 元</p>\n        <p>总收益：${(totalAmount - totalInvestment).toFixed(2)} 元</p>\n      `;\n\n      if (compoundChart) {\n        compoundChart.destroy();\n      }\n\n      const ctx = document.getElementById('compoundChart').getContext('2d');\n      const chartData = {\n        labels: labels,\n        datasets: [\n          {\n            label: '本金 (元)',\n            data: principalData,\n            backgroundColor: 'rgba(75, 192, 192, 0.6)',\n            borderColor: 'rgba(75, 192, 192, 1)',\n            borderWidth: 1,\n          },\n          {\n            label: '复利 (元)',\n            data: compoundData,\n            backgroundColor: 'rgba(192, 75, 75, 0.6)',\n            borderColor: 'rgba(192, 75, 75, 1)',\n            borderWidth: 1,\n          },\n        ],\n      };\n      compoundChart = new Chart(ctx, {\n        type: 'bar',\n        data: chartData,\n        options: {\n          responsive: true,\n          plugins: {\n            tooltip: {\n              callbacks: {\n                label: function(tooltipItem) {\n                  const datasetIndex = tooltipItem.datasetIndex;\n                  const value = tooltipItem.raw;\n                  if (datasetIndex === 0) {\n                    return `本金：${value.toLocaleString()} 元`;\n                  } else {\n                    const principal = principalData[tooltipItem.dataIndex];\n                    const compound = value;\n                    const total = principal + compound;\n                    return [\n                      `本金：${principal.toLocaleString()} 元`,\n                      `复利：${compound.toLocaleString()} 元`,\n                      `总收益：${total.toLocaleString()} 元`,\n                    ];\n                  }\n                },\n              },\n            },\n          },\n          scales: {\n            x: { \n              title: { display: true, text: `投资时间（以${labelUnit}为单位）` }, \n              stacked: true \n            },\n            y: { \n              title: { display: true, text: '金额 (元)' },\n              stacked: true,\n              ticks: {\n                stepSize: 10000,\n                callback: function(value) {\n                  if (value >= 10000) {\n                    return (value / 10000) + ' 万';\n                  }\n                  return value.toLocaleString() + ' 元';\n                },\n              },\n            },\n          },\n        },\n      });\n    }\n\n    function resetCalculator() {\n      document.getElementById('initialInvestment').value = 0;\n      document.getElementById('monthlyIncrease').value = 5;\n      document.getElementById('years').value = 1;\n      document.getElementById('returnRate').value = 1;\n      document.getElementById('frequency').value = 'daily';\n      document.getElementById('result').innerHTML = '';\n\n      if (compoundChart) {\n        compoundChart.destroy();\n        compoundChart = null;\n      }\n    }\n  </script>\n</body>\n</html>",
    "contentHtml": ""
  },
  {
    "id": 178,
    "slug": "存款利息计算器",
    "title": "存款利息计算器",
    "date": "2024-12-29",
    "isCalculator": true,
    "calculatorHtml": "\n                                <p class=\"p1\">    <div class=\"sic_outer_container\" style=\"display:flex; justify-content:center;\">\n        <div class=\"sic_container\">\n            <h2>单利计算器</h2>\n            <p>单利计算器根据单利公式计算利息和期末余额。在现实生活中，大多数利息计算都涉及复利。要计算复利，请使用利息计算器。</p>\n            <form method=\"post\" class=\"sic_form\">\n                <div class=\"sic_form_group\">\n                    <label>选择货币：</label>\n                    <select name=\"sic_currency\" class=\"sic_select\">\n                        <option value=\"CNY\"  selected='selected'>人民币（￥）</option>\n                        <option value=\"USD\" >美元（$）</option>\n                        <option value=\"EUR\" >欧元（€）</option>\n                        <option value=\"GBP\" >英镑（£）</option>\n                        <option value=\"JPY\" >日元（¥）</option>\n                    </select>\n                </div>\n\n                <div class=\"sic_form_group\">\n                    <label>本金金额：</label>\n                    <div class=\"sic_input_wrapper\">\n                        <input type=\"number\" name=\"sic_principal\" value=\"1000\" step=\"0.01\" required>\n                    </div>\n                </div>\n\n                <div class=\"sic_form_group\">\n                    <label>年利率：</label>\n                    <div class=\"sic_input_wrapper\">\n                        <input type=\"number\" name=\"sic_rate\" value=\"4\" step=\"0.01\" required>\n                        <span class=\"sic_symbol\">%</span>\n                    </div>\n                    <p class=\"sic_note\">每年</p>\n                </div>\n\n                <div class=\"sic_form_group\">\n                    <label>时期：</label>\n                    <div class=\"sic_input_wrapper\">\n                        <input type=\"number\" name=\"sic_time\" value=\"10\" step=\"0.1\" required>\n                    </div>\n                    <p class=\"sic_note\">请输入数值，并选择周期单位</p>\n                </div>\n\n                <div class=\"sic_form_group\">\n                    <label>周期：</label>\n                    <select name=\"sic_period\" class=\"sic_select\">\n                        <option value=\"day\" >日</option>\n                        <option value=\"week\" >周</option>\n                        <option value=\"month\" >月</option>\n                        <option value=\"year\"  selected='selected'>年</option>\n                    </select>\n                </div>\n\n                <div class=\"sic_button_group\">\n                    <input type=\"submit\" name=\"sic_submit\" value=\"计算\" class=\"sic_calc_btn\" />\n                    <input type=\"button\" value=\"重置\" class=\"sic_reset_btn\" onclick=\"sicResetForm()\" />\n                </div>\n            </form>\n\n            <div class='sic_result_box'>\n                        <div class='sic_result_wrapper'>\n                            <p>利息金额：<strong>￥</strong></p>\n                            <p>总量：<strong>￥</strong></p>\n                        </div>\n                    </div>\n            <h3>什么是单利？</h3>\n            <p>利息是您借钱支付的费用或您借钱获得的补偿。单利是指仅根据借入或存入的初始金额（“本金”）计算的利息。未来的利息支付不会受到先前应计利息的影响。</p>\n\n            <h3>单利公式</h3>\n            <p>单利 = 本金金额 × 利率 × 时间</p>\n            <p>例如，如果本金为 10,000 元，年利率为 5%，期限为 5 年，则总利息为 10,000 × 0.05 × 5 = 2,500 元。</p>\n\n            <h3>单利与复利</h3>\n            <p>单利只对原始本金计算利息，而复利对本金和之前的利息再次计息。长期来看，复利会比单利产生更多的总利息。</p>\n\n        </div>\n    </div>\n    <script>\n        function sicResetForm() {\n            const form = document.querySelector('.sic_form');\n            form.reset(); // 重置表单\n            form.querySelector('input[name=\"sic_principal\"]').value = '';\n            form.querySelector('input[name=\"sic_rate\"]').value = '';\n            form.querySelector('input[name=\"sic_time\"]').value = '';\n        }\n    </script>\n    <style>\n        .sic_container {\n            font-family: \"Microsoft Yahei\", Arial, sans-serif;\n            border: 1px solid #ddd;\n            padding: 20px;\n            border-radius: 5px;\n            background: #fafafa;\n            max-width: 400px;\n            text-align: left; \n        }\n\n        .sic_container h2 {\n            margin-top: 0;\n            text-align: center;\n        }\n\n        .sic_form_group {\n            margin-bottom: 15px;\n        }\n\n        .sic_form_group label {\n            display: block;\n            font-weight: bold;\n            margin-bottom: 5px;\n        }\n\n        .sic_input_wrapper {\n            position: relative;\n        }\n\n        .sic_symbol {\n            position: absolute;\n            right: 10px;\n            top: 50%;\n            transform: translateY(-50%);\n            color: #666;\n        }\n\n        .sic_input_wrapper input {\n            width: 100%;\n            padding: 5px 30px 5px 5px;\n            border: 1px solid #ccc;\n            border-radius: 3px;\n        }\n\n        .sic_select {\n            width: 100%;\n            padding: 5px;\n            border-radius: 3px;\n            border: 1px solid #ccc;\n        }\n\n        .sic_button_group {\n            display: flex;\n            gap: 10px;\n        }\n\n        .sic_calc_btn, .sic_reset_btn {\n            background: #008000;\n            color: #fff;\n            border: none;\n            padding: 8px 15px;\n            border-radius: 3px;\n            cursor: pointer;\n        }\n\n        .sic_reset_btn {\n            background: #888;\n        }\n\n        .sic_result_box {\n            margin-top: 15px;\n            border: 2px solid #008000;\n            border-radius: 5px;\n            padding: 10px;\n            background: #eaffea;\n        }\n\n        .sic_result_wrapper {\n            background: #f7f7f7;\n            padding: 10px;\n            border-radius: 5px;\n        }\n\n        .sic_result_wrapper p {\n            margin: 5px 0;\n        }\n\n        .sic_note {\n            font-size: 12px;\n            color: #666;\n            margin-top: 3px;\n        }\n    </style>\n    </p>\n                            </div>\n        </div>\n        </div>\n                </div>\n    </div>\n    <div class=\"sidebar sidebar-tools d-none d-lg-block\">\n\t\t\n\t\t\t\t\t<div id=\"custom_html-10\" class=\"widget_text card io-sidebar-widget widget_custom_html\"><div class=\"textwidget custom-html-widget\"><a href=\"https://dt.bd.cn/#/pages/login/register?invite_code=2549125\" target=\"_blank\"><img src=\"https://tmhzz.com/wp-content/themes/onenav/assets/images/ad.jpg\" alt=\"网盘推广，别人转存就有钱\" /></a></div></div><div id=\"custom_html-18\" class=\"widget_text card io-sidebar-widget widget_custom_html\"><div class=\"textwidget custom-html-widget\"><script async src=\"https://pagead2.googlesyndication.com/pagead/js/adsbygoogle.js?client=ca-pub-3412124316994451\"\n     crossorigin=\"anonymous\"></script>\n<!-- 小工具广告 -->\n<ins class=\"adsbygoogle\"\n     style=\"display:block\"\n     data-ad-client=\"ca-pub-3412124316994451\"\n     data-ad-slot=\"6333026284\"\n     data-ad-format=\"auto\"\n     data-full-width-responsive=\"true\"></ins>\n<script>\n     (adsbygoogle = window.adsbygoogle || []).push({});\n</script></div></div><div id=\"custom_html-4\" class=\"widget_text card io-sidebar-widget widget_custom_html\"><div class=\"card-header widget-header\"><h3 class=\"text-md mb-0\">计算器</h3></div><div class=\"textwidget custom-html-widget\"><div class=\"calc-container\">\n    <h2>选择您需要的计算器</h2>\n    <ul>\n        <li><a href=\"https://tmhzz.com/index.php/%e5%a4%8d%e5%88%a9%e8%ae%a1%e7%ae%97%e5%99%a8/\">定投复利计算器</a></li>\n        <li><a href=\"https://tmhzz.com/index.php/%e5%ad%98%e6%ac%be%e5%88%a9%e6%81%af%e8%ae%a1%e7%ae%97%e5%99%a8/\">存款利率计算器</a></li>\n\t\t\t<li><a href=\"https://tmhzz.com/index.php/%e9%80%80%e4%bc%91%e5%b9%b4%e9%be%84%e8%ae%a1%e7%ae%97%e5%99%a8/\">退休年龄计算器</a></li>\n    </ul>\n</div>\n\n<style>\n.calc-container {\n    text-align: center;\n    margin: 40px auto;\n    max-width: 300px;\n    font-family: \"Microsoft Yahei\", Arial, sans-serif;\n}\n\n.calc-container h2 {\n    font-size: 24px;\n    margin-bottom: 30px;\n    color: #333;\n}\n\n.calc-container ul {\n    list-style: none;\n    padding: 0;\n    margin: 0;\n}\n\n.calc-container li {\n    margin: 20px 0;\n}\n\n.calc-container a {\n    display: inline-block;\n    width: 100%;\n    background: #007acc; \n    color: #fff;\n    font-weight: bold;\n    font-size: 16px;\n    padding: 15px 0;\n    border-radius: 10px;\n    text-decoration: none;\n    box-shadow: 0 4px 6px rgba(0,0,0,0.1);\n    transition: background 0.3s ease;\n}\n\n.calc-container a:hover {\n    background: #005fa3;\n}\n</style></div></div><div id=\"iow_tag_cloud_tool-5\" class=\"card io-sidebar-widget io-widget-tag-cloud\"><div class=\"sidebar-header \"><div class=\"card-header widget-header\"><h3 class=\"text-md mb-0\"><i class=\"mr-2 iconfont icon-tools\"></i>标签云</h3></div></div><span class=\"ajax-auto-post auto\" data-href=\"https://tmhzz.com/wp-admin/admin-ajax.php\" data-target=\"#iow_tag_cloud_tool-5 .ajax-panel\" data-action=\"load_tag_cloud\" data-instance=\"{&quot;window&quot;:&quot;1&quot;,&quot;taxonomy&quot;:[&quot;sitetag&quot;],&quot;count&quot;:&quot;20&quot;,&quot;orderby&quot;:&quot;name&quot;,&quot;show_count&quot;:&quot;&quot;}\"></span><div class=\"card-body d-flex flex-wrap ajax-panel\" style=\"gap: 6px;\"><div class=\"placeholder flex-fill\" style=\"--height:30px;--width:102px;\"></div><div class=\"placeholder flex-fill\" style=\"--height:30px;--width:57px;\"></div><div class=\"placeholder flex-fill\" style=\"--height:30px;--width:115px;\"></div><div class=\"placeholder flex-fill\" style=\"--height:30px;--width:47px;\"></div><div class=\"placeholder flex-fill\" style=\"--height:30px;--width:79px;\"></div><div class=\"placeholder flex-fill\" style=\"--height:30px;--width:97px;\"></div><div class=\"placeholder flex-fill\" style=\"--height:30px;--width:44px;\"></div><div class=\"placeholder flex-fill\" style=\"--hei